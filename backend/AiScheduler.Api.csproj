<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiScheduler.Api</RootNamespace>
    <AssemblyName>AiScheduler.Api</AssemblyName>
    <UserSecretsId>ai-scheduler-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core + PostgreSQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Swagger / OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />

    <!-- Google Vertex AI SDK (official, for Gemini function-calling) -->
    <PackageReference Include="Google.Cloud.AIPlatform.V1" Version="3.13.0" />

    <!-- Google Application Default Credentials helper -->
    <PackageReference Include="Google.Apis.Auth" Version="1.68.0" />

    <!-- pgvector support for embeddings -->
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>

  <!-- Agent source lives in the top-level agent/ directory -->
  <ItemGroup>
    <Compile Include="..\agent\**\*.cs" Link="Agent\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
